      "targetField": "title",
      "required": true
    },
    "blocks": {
      "type": "dynamiczone",
      "components": [
        "sections.hero",
        "sections.product-grid",
        "sections.stats-band",
        "sections.spotlight",
        "sections.pricing",
        "sections.demo-cases",
        "sections.ai-showcase",
        "sections.testimonials",
        "sections.trust-badges",
        "sections.resources-lead"
      ]
    }
  }
}
